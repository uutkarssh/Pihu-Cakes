# ===== Pihu Cakes & Bakes — Environment Variables =====
# Copy this file to .env locally, and set these in Vercel Project Settings → Environment Variables.

# ----- Database (Prisma / SQLite) -----
# Local dev: file-based SQLite. On Vercel, use a Turso/Postgres URL or @prisma/adapter-better-sqlite3.
DATABASE_URL="libsql://pihu-cakes-uutkarssh.aws-ap-south-1.turso.io"

# ----- Gemini API Key (for AI chatbot, recommendations, smart search, etc.) -----
# Get your key from Google AI Studio: https://aistudio.google.com/apikey
# Without this, AI features will show graceful fallback messages.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"

# ----- Admin Cookie Secret (for HMAC-signed auth) -----
# Set a strong random string in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_COOKIE_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION"

# ----- Firebase (client-side, safe to expose) -----
# Already hardcoded in src/lib/firebase.ts. To move to env vars, set these:
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""