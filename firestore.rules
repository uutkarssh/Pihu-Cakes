rules_version = '2';

// Pihu Cakes & Bakes — Firestore Security Rules
// Copy these rules into Firebase Console → Firestore Database → Rules → Publish.
//
// Structure:
//   users/{uid}                    — user profile (name, email, mobile)
//   users/{uid}/wishlist/{prodId}  — wishlist items
//
// Rules:
//   - Users can read/write ONLY their own profile and wishlist.
//   - Unauthenticated users have no access to Firestore.
//   - All product/order/category data is stored in the Prisma database
//     (NOT Firestore), so it doesn't need Firestore rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — only the owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Wishlist subcollection — only the owner can read/write
      match /wishlist/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
